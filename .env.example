# ── Server ──────────────────────────────────────────────
PORT=4000
NODE_ENV=development
APP_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# ── Database (PostgreSQL) ───────────────────────────────
DATABASE_URL=postgres://gayathris@localhost:5432/smartwatch
PGUSER=gayathris
PGHOST=localhost
PGPORT=5432
PGDATABASE=smartwatch
PGPASSWORD=

# ── Redis (optional — falls back to in-memory if unreachable)
REDIS_URL=redis://localhost:6379

# ── Auth / JWT ──────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-dev-only
JWT_REFRESH_SECRET=change-me-refresh-secret-dev-only
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL=30d
BCRYPT_COST=12

# ── Google OAuth (leave blank to run Google as a stub/demo)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Optional AI (leave blank → deterministic offline analyst)
OPENAI_API_KEY=

# ── Email (news digest — leave blank to preview instead of send)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SMARTWATCH <news@smartwatch.app>

# ── Demo mode ───────────────────────────────────────────
DEMO_MODE_DEFAULT=true
SEED_DEMO_ACCOUNT=true

# Market-status testing (dev only — never in production)
# SIMULATE_MARKET_OPEN=true   # treat as REGULAR/open outside NSE/BSE hours
# FORCE_SIMULATOR=true        # skip TradingView, use the simulator
# LIVE_FEED_LICENSED=true     # ONLY with an authorized broker real-time feed
