# Leave both blank for local dev + the bundled reverse proxy (same-origin auto).
# When deploying frontend & backend to different hosts, set the backend's real
# public origin here (e.g. https://smartwatch-api.onrender.com). A localhost
# value is ignored when the page is served from a remote host.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
